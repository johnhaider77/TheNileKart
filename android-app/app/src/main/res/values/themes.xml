<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme - No ActionBar for full WebView experience -->
    <style name="Base.Theme.TheNileKart" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/thenilekart_primary</item>
        <!-- Primary dark color for status bar -->
        <item name="colorPrimaryDark">@color/thenilekart_primary_dark</item>
        <!-- Accent color for buttons and highlights -->
        <item name="colorAccent">@color/thenilekart_accent</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/thenilekart_primary_dark</item>
        <!-- Hide the ActionBar completely -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.TheNileKart" parent="Base.Theme.TheNileKart" />
</resources>
