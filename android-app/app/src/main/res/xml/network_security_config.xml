<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) traffic for development/testing -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Allow HTTP to specific development server -->
        <domain includeSubdomains="true">40.172.190.250</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
    <!-- All other domains require HTTPS -->
    <default-config cleartextTrafficPermitted="false" />
</network-security-config>
