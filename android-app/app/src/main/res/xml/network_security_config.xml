<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) traffic for development/testing -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Allow HTTP to specific development server -->
        <domain includeSubdomains="true">40.172.190.250</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
    
    <!-- Trust system certificate store for HTTPS domains -->
    <domain-config>
        <domain includeSubdomains="true">www.thenilekart.com</domain>
        <domain includeSubdomains="true">thenilekart.com</domain>
        <!-- Use system certificate store for this domain -->
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
